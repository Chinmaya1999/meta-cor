FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci -w backend --include-workspace-root=false --include=dev
COPY shared shared
COPY backend backend
WORKDIR /app/backend
RUN mkdir -p uploads && chown -R node:node /app/backend/uploads
USER node
EXPOSE 5001
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s CMD wget -qO- http://127.0.0.1:5001/api/settings/public >/dev/null || exit 1
CMD ["npx", "tsx", "src/server.ts"]

NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/metawealth
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173

# Email (leave SMTP_HOST empty to log emails to the console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MetaWealth Capital <no-reply@example.com>"
# Where enquiry/booking notifications are sent (client must confirm)
NOTIFY_EMAIL=

# First admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
